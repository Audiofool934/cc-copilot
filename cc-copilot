#!/usr/bin/env bash
# Thin launcher so you can run cc-copilot from anywhere without installing.
# It keeps your current working directory (so session resolution targets the
# project you're actually in) and puts the package on PYTHONPATH.
#
# PYTHONSAFEPATH=1 (py3.11+) stops Python from prepending the cwd to sys.path —
# otherwise a stray file in your project dir (e.g. inspect.py, types.py) would
# shadow a stdlib module and crash us. The package is still found via PYTHONPATH.
# Resolve symlinks so `ln -s …/cc-copilot ~/.local/bin/cc-copilot` works:
# find the real script dir (which holds the cccopilot/ package), not the symlink.
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [ "${src#/}" = "$src" ] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"
exec env PYTHONSAFEPATH=1 PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" python3 -m cccopilot "$@"
